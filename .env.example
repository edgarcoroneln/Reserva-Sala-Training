# Copia este archivo a `.env` y ajusta los valores. NUNCA subas tu `.env` real.

# --- Servidor ---
PORT=3000
DB_PATH=./data/reservas.db

# --- Administrador inicial (se crea al primer arranque si no existe) ---
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-contrasena

# --- Correos ---
# Destino del reporte mensual a finanzas (también configurable desde el módulo admin).
REPORT_EMAIL=finanzas@ejemplo.com
# Correo que recibe el aviso de nuevas pre-reservas pendientes.
ADMIN_NOTIFY_EMAIL=admin@ejemplo.com

# --- Transporte de correo ---
# console = registra el correo en la tabla `emails` y en consola (por defecto).
# graph   = envía por Microsoft Graph (requiere las variables GRAPH_* de abajo).
MAIL_TRANSPORT=console

# --- Microsoft Graph (solo si MAIL_TRANSPORT=graph) ---
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=buzon-institucional@tu-dominio.com
